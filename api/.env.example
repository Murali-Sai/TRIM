# Copy to api/.env for local development. Never commit the real .env.
TRIM_ENV=dev
# App role: member of trim_app, not the owner, no BYPASSRLS.
TRIM_DATABASE_URL=postgresql+psycopg://trim_api:trim_api@127.0.0.1:5433/trim
# Owner role, used only by Alembic.
TRIM_MIGRATION_DATABASE_URL=postgresql+psycopg://trim:trim@127.0.0.1:5433/trim
